# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real values — only this .env.example is versioned.

# --- Django ---
DEBUG=True
WEB_PORT=8080
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
JIFFY_GATEWAY_IMAGE_VERSION=dev

# --- Database ---
# SQLite file shared by the web service (writes the Task row) and the Celery
# worker (reads it back).  Both containers MUST resolve this to the same file —
# if they don't, the worker logs "Task not found in DB" for every job.
# Defaults to <project>/data/db.sqlite3.
# DATABASE_PATH=/app/data/db.sqlite3


# --- Redis ---
# These URLs use 127.0.0.1 for local development (running outside Docker).
# Inside docker-compose, the Celery service overrides them to use the Docker
# DNS name "redis" — see docker-compose.yml environment section.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Ingestion Tokens (per-provider shared secrets, sent via X-JIFFY-TOKEN header) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Each provider needs its own unique secret — never reuse across providers.
GITHUB_INGEST_TOKEN=123456789alcjQJE!@O!@SFsdf2312
GITLAB_INGEST_TOKEN=
GITEA_INGEST_TOKEN=

# --- Sentry (production only) ---
# SENTRY_DSN=

# --- Sandbox Container ---
SANDBOX_IMAGE=jiffy-sandbox:1.2.0

# Resource limits applied to every sandbox container.  Tune these to your host:
# the defaults below assume the host can spare ~2 GB RAM and ~1.5 cores per
# concurrently running task.
# Hard RAM limit for the container.
# SANDBOX_MEMORY_LIMIT=2g
# Combined memory + swap ceiling.  MUST be >= SANDBOX_MEMORY_LIMIT; the
# difference is how far the container may spill into swap instead of being
# OOM-killed (exit 137) during heavy installs.  Use -1 for unlimited swap.
# If it is set lower than SANDBOX_MEMORY_LIMIT the Gateway warns and uses 2x
# the memory limit instead.
# SANDBOX_MEMORY_SWAP_LIMIT=4g
# CPU quota in (fractional) cores, e.g. 1.5.
# SANDBOX_CPU_LIMIT=1.5

# Package-manager memory pressure inside the sandbox.
# Node heap cap in MiB.  Leave unset to derive it from SANDBOX_MEMORY_LIMIT
# (half the container memory, floor 512).
# SANDBOX_NODE_MAX_OLD_SPACE_MB=1024
# Parallel install/build jobs (npm/pnpm/cargo/make/go).  Lower = slower but
# much less likely to be OOM-killed.
# SANDBOX_PACKAGE_CONCURRENCY=2

# How long (seconds) a single agent run may take before the Gateway gives up
# and fails the task.  Enforced by the Gateway itself, so it is independent of
# any Docker client or socket-proxy request timeout.
# SANDBOX_AGENT_TIMEOUT=3600

# --- Celery worker ---
# How many tasks a worker runs in parallel.  Each slot can hold a full sandbox
# container, so multiply this by SANDBOX_MEMORY_LIMIT to size the host.
# Keep at 1 on constrained hosts to serialise execution.
CELERY_WORKER_CONCURRENCY=1
# Whether to stop and remove the sandbox container after each job.
# Set to "false" to leave the container running for debugging.
JIFFY_SANDBOX_CLEANUP=true

# Network egress restriction for sandbox containers.
# Default is "true" (restricted to the allow-list below).  Set to "false" to
# fully disable the restriction (open network) for debugging.
JIFFY_SANDBOX_NETWORK_RESTRICTED=true

# Comma-separated list of hostnames the sandbox container can reach when
# restriction is active.  Includes package registries (PyPI, npm, Go, crates)
# and git provider hosts by default.  If set, this REPLACES the defaults.
# SANDBOX_NETWORK_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org,crates.io,static.crates.io,proxy.golang.org,sum.golang.org,github.com,api.github.com,objects.githubusercontent.com,codeload.github.com,gitlab.com,gitea.com

# Additional hostnames APPENDED to the allow-list (defaults or the override
# above).  Use this for self-hosted git server instances and the LLM provider
# endpoint OpenCode is configured to use — these vary per install.
# SANDBOX_NETWORK_ALLOWLIST_EXTRA=git.example.com,llm.example.com

# --- Docker Socket Proxy ---
# Required for the Celery worker to manage sandbox containers.
# In docker-compose this is set automatically; for local dev outside containers,
# leave unset to use the default Docker socket.
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# --- AGENT CONFIG ---
# The OpenCode config is read from the project-root opencode.json and injected
# into each sandbox container — there is no env var for its path.
