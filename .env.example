# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real values — only this .env.example is versioned.

# --- Django ---
DEBUG=True
WEB_PORT=8080
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
JIFFY_IMAGE_VERSION=latest


# --- Redis ---
# These URLs use 127.0.0.1 for local development (running outside Docker).
# Inside docker-compose, the Celery service overrides them to use the Docker
# DNS name "redis" — see docker-compose.yml environment section.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Ingestion Tokens (per-provider shared secrets, sent via X-JIFFY-TOKEN header) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Each provider needs its own unique secret — never reuse across providers.
GITHUB_INGEST_TOKEN=123456789alcjQJE!@O!@SFsdf2312
GITLAB_INGEST_TOKEN=
GITEA_INGEST_TOKEN=

# --- Sentry (production only) ---
# SENTRY_DSN=

# --- Sandbox Container ---
SANDBOX_IMAGE=jiffy-sandbox:1.2.0
# SANDBOX_MEM_LIMIT=1g
# SANDBOX_CPU_LIMIT=1
# Whether to stop and remove the sandbox container after each job.
# Set to "false" to leave the container running for debugging.
JIFFY_SANDBOX_CLEANUP=true

# Network egress restriction for sandbox containers.
# Default is "true" (restricted to the allow-list below).  Set to "false" to
# fully disable the restriction (open network) for debugging.
JIFFY_SANDBOX_NETWORK_RESTRICTED=true

# Comma-separated list of hostnames the sandbox container can reach when
# restriction is active.  Includes package registries (PyPI, npm, Go, crates)
# and git provider hosts by default.  If set, this REPLACES the defaults.
# SANDBOX_NETWORK_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org,crates.io,static.crates.io,proxy.golang.org,sum.golang.org,github.com,api.github.com,objects.githubusercontent.com,codeload.github.com,gitlab.com,gitea.com

# Additional hostnames APPENDED to the allow-list (defaults or the override
# above).  Use this for self-hosted git server instances and the LLM provider
# endpoint OpenCode is configured to use — these vary per install.
# SANDBOX_NETWORK_ALLOWLIST_EXTRA=git.example.com,llm.example.com

# --- Docker Socket Proxy ---
# Required for the Celery worker to manage sandbox containers.
# In docker-compose this is set automatically; for local dev outside containers,
# leave unset to use the default Docker socket.
# DOCKER_HOST=tcp://docker-socket-proxy:2375



# --- AGENT CONFIG ---
SANDBOX_OPENCODE_CONFIG_PATH=E:\repo\community\jiffy\jiffy_gateway\docker\sandbox\opencode.json
